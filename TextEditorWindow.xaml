<Window x:Class="StickIt.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit text list" Width="620" Height="500" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource WindowBackground}" FontFamily="Segoe UI"
        Closing="TextEditorWindow_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileNameText" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                   Margin="1,0,0,8" />

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="6">
            <TextBox x:Name="EditorTextBox" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     Background="Transparent" Foreground="{StaticResource TextPrimary}"
                     CaretBrush="{StaticResource TextPrimary}" SelectionBrush="#FF5367A3"
                     BorderThickness="0" Padding="2" UndoLimit="1000"
                     TextChanged="EditorTextBox_TextChanged" />
        </Border>

        <DockPanel Grid.Row="2" Margin="1,9,0,0" LastChildFill="False">
            <TextBlock x:Name="SaveStatusText" DockPanel.Dock="Left" Text="No unsaved changes"
                       FontSize="10" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Width="76" Height="28" Padding="7,4" Margin="0,0,6,0"
                        FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Content="Save" Width="76" Height="28" Padding="7,4" Margin="0"
                        FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
