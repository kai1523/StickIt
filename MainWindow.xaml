<Window x:Class="StickIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="StickIt" Width="300" Height="440" MinWidth="300" MinHeight="320"
        Topmost="True" ResizeMode="CanResizeWithGrip" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" Background="Transparent" FontFamily="Segoe UI">
    <Grid Background="Transparent">
      <Grid x:Name="MainView" Margin="8" PreviewMouseDown="MainView_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TopBar" Grid.Row="0" Margin="0" MinHeight="27" Panel.ZIndex="2"
              Background="Transparent" PreviewMouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Content="Refresh" Padding="7,3" FontSize="10" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Click="RefreshButton_Click" />
            <TextBlock x:Name="WindowSizeText" Grid.Column="1" Text="350 × 500"
                       Margin="7,0,0,0" VerticalAlignment="Center" FontSize="9"
                       Foreground="{StaticResource TextMuted}" />
            <Button x:Name="SettingsButton" Grid.Column="2" Content="Settings ▾" Width="76"
                    Padding="5,3" FontSize="10" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Click="SettingsButton_Click" />
            <Button x:Name="MinimizeButton" Grid.Column="3" Content="−" Width="22" Padding="2"
                    FontSize="12" VerticalAlignment="Center" HorizontalContentAlignment="Center" Tag="Minimize"
                    ToolTip="Minimize" Click="MinimizeButton_Click" />
            <Button x:Name="CloseButton" Grid.Column="4" Content="×" Width="22" Padding="2"
                    FontSize="12" VerticalAlignment="Center" HorizontalContentAlignment="Center" Tag="Close"
                    ToolTip="Close" Click="CloseButton_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="67" MinWidth="66" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FilePanelBorder" Grid.Column="0" Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="0" Padding="6" SizeChanged="FilePanel_SizeChanged"
                    AllowDrop="True" DragEnter="FilePanel_DragEnter" DragOver="FilePanel_DragOver"
                    Drop="FilePanel_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="1,0,1,4">
                        <TextBlock Text="FILES" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FileList" />
                    </ScrollViewer>
                    <TextBlock x:Name="LeftPanelWidthText" Grid.Row="2" Text="W 100"
                               Margin="1,3,0,0" FontSize="9" Foreground="{StaticResource TextMuted}"
                               ToolTip="Left panel width in WPF units" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Background="{StaticResource PanelBorder}"
                          ToolTip="Drag to resize panels" Cursor="SizeWE" />

            <Border x:Name="ContentPanelBorder" Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="1,0,1,5">
                        <TextBlock x:Name="SelectedFileTitle" Text="Select a text file"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ContentItems" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel x:Name="BottomBar" Grid.Row="2" Margin="0" LastChildFill="True"
                   Background="Transparent">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="v1.06.03"
                       FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            <Border x:Name="StatusIndicatorBorder" VerticalAlignment="Stretch"
                    Padding="5,6.5" BorderThickness="0" CornerRadius="0"
                    Background="#FF252A33" BorderBrush="#FF383E49">
                <TextBlock x:Name="StatusText" Text="Looking for .txt files…" FontSize="10"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="210" />
            </Border>
        </DockPanel>

        <Border x:Name="SettingsDropdownBorder" Grid.Row="0" Grid.RowSpan="2"
                Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,27,0,0" Width="136" Padding="4"
                Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <primitives:ToggleButton x:Name="WrapButton" Content="Wrap" FontSize="10" Padding="5,3"
                                         Margin="0,0,0,2" HorizontalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         Click="WrapButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="DecreaseFadeOpacityButton" Content="−" Width="28"
                            Padding="0,3" Margin="0,0,2,0" FontSize="10"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="FadeOpacityButton_Click" />
                    <primitives:ToggleButton x:Name="FadeButton" Content="Fade" Width="66"
                                             FontSize="10" Padding="0,3" Margin="0,0,2,0"
                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             IsChecked="True" Click="FadeButton_Click" />
                    <Button x:Name="IncreaseFadeOpacityButton" Content="+" Width="28"
                            Padding="0,3" Margin="0" FontSize="10"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="FadeOpacityButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
      </Grid>

      <Border x:Name="BubbleView" Width="68" Height="68" HorizontalAlignment="Center"
              VerticalAlignment="Center" BorderBrush="#FFD1B44E" BorderThickness="1"
              CornerRadius="0" Visibility="Collapsed">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="BubbleHeader" Grid.Row="0" Background="#FFE7C65F"
                    PreviewMouseLeftButtonDown="BubbleHeader_MouseLeftButtonDown" Cursor="SizeAll">
                <TextBlock Text="•••" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" FontWeight="Bold" Foreground="#FF796526" />
            </Border>
            <Button x:Name="BubbleRestoreButton" Grid.Row="1" Content="OPEN" Margin="0" Padding="0"
                    Background="#FFFFEAA0" BorderThickness="0" FontSize="8" FontWeight="SemiBold"
                    Foreground="#FF5A4B24" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" Click="RestoreFromBubble_Click" ToolTip="Restore StickIt">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
      </Border>

      <primitives:Popup x:Name="FileActionsPopup" Placement="Right" StaysOpen="False"
                        AllowsTransparency="True">
        <Border Width="150" Padding="4" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
            <StackPanel>
                <Button x:Name="OpenInEditorButton" Content="Open in editor" Padding="6,4"
                        Margin="0,0,0,3" FontSize="10" HorizontalContentAlignment="Left"
                        Click="OpenInEditorButton_Click" />
                <Button x:Name="ShowInExplorerButton" Content="Show in Explorer" Padding="6,4"
                        Margin="0" FontSize="10" HorizontalContentAlignment="Left"
                        Click="ShowInExplorerButton_Click" />
            </StackPanel>
        </Border>
      </primitives:Popup>
    </Grid>
</Window>
